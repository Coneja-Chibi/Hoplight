#!/bin/sh
# Full local proof lives here so the commit reflex stays fast.
bun run typecheck
if [ $? -ne 0 ]; then
  echo "GUARDRAIL BLOCK (typecheck): tsc is red. Fix types before pushing." >&2
  exit 1
fi
bun run test
if [ $? -ne 0 ]; then
  echo "GUARDRAIL BLOCK (tests): bun run test is red. Fix tests before pushing." >&2
  exit 1
fi
exit 0
