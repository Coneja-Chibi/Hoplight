          "name": "xmlTagName",
          "optional": true,
          "type": "string",
          "meaning": "",
          "producers": []
        },
        {
          "name": "extras",
          "optional": true,
          "type": "Record<string, unknown>",
          "meaning": "per-platform leftovers with no first-class home; sealed, round-trips untouched.",
          "producers": []
        }
      ]
    },
    {
      "name": "PresetGroup",
      "doc": "A category / folder of blocks. Canonical because Marinara `groups` and RC categories are first-class and the editor authors them. ST has no real groups - it encodes them as divider PROMPTS; the ST codec bridges by DERIVING a divider identifier deterministically from this `id` for vaud-authored groups and ESCROWING the original divider identifier only for imported ST presets. That keeps the Round-Trip Law under EDITS (add/rename/move a group), not just import - a user-added group must never gain an escrow entry it lacked (PRESET-JEWEL-PLAN.md).",
      "kind": "interface",
      "fields": [
        {
          "name": "id",
          "optional": false,
          "type": "string",
          "meaning": "stable canonical id; the ST codec derives its divider identifier from this deterministically.",
          "producers": [
            "ST"
          ]
        },
        {
          "name": "name",
          "optional": false,
          "type": "string",
          "meaning": "",
          "producers": []
        },
        {
          "name": "content",
          "optional": true,
          "type": "string",
          "meaning": "nemo-wiki dividers may carry content; legacy ST + Marinara groups do not.",
          "producers": [
            "ST",
            "Marinara"
          ]
        },
        {
          "name": "parentGroupId",
          "optional": true,
          "type": "string",
          "meaning": "parent group id for nesting (Marinara `parentGroupId` / RC subcategories); absent = top.",
          "producers": [
            "RC",
            "Marinara"
          ]
        },
        {
          "name": "order",
          "optional": true,
          "type": "number",
          "meaning": "",
          "producers": []
        },
        {
          "name": "enabled",
          "optional": true,
          "type": "boolean",
          "meaning": "",
          "producers": []
        },
        {
          "name": "extras",
          "optional": true,
          "type": "Record<string, unknown>",
          "meaning": "",
          "producers": []
        }
      ]
    },
