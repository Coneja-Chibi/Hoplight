  "shapes": [
    {
      "name": "PresetPrompt",
      "doc": "One prompt block - the row in the manuscript.",
      "kind": "interface",
      "fields": [
        {
          "name": "id",
          "optional": false,
          "type": "string",
          "meaning": "Stable block id = the VERBATIM source identifier (ST `identifier`, Marinara section `identifier`). NEVER a fresh vaud-minted id: prompt-order refs, marker resolution, and `isDefault` all key off it, and re-minting would break every round-trip. This field is EXEMPT from the UUID regeneration the other entities apply.",
          "producers": [
            "ST",
            "Marinara"
          ]
        },
        {
          "name": "name",
          "optional": false,
          "type": "string",
          "meaning": "",
          "producers": []
        },
        {
          "name": "content",
          "optional": false,
          "type": "string",
          "meaning": "",
          "producers": []
        },
        {
          "name": "role",
          "optional": false,
          "type": "PromptRole",
          "meaning": "",
          "producers": []
        },
        {
          "name": "enabled",
          "optional": false,
          "type": "boolean",
          "meaning": "",
          "producers": []
        },
        {
          "name": "systemPrompt",
          "optional": false,
          "type": "boolean",
          "meaning": "ST `system_prompt`: rendered as a system-role prompt-manager entry.",
          "producers": [
            "ST"
          ]
        },
        {
          "name": "marker",
          "optional": false,
          "type": "boolean",
          "meaning": "structural placeholder (chat history / world info / examples) with no content of its own.",
          "producers": []
        },
        {
          "name": "markerSlot",
          "optional": true,
          "type": "string",
          "meaning": "When `marker`, the ST-compatible slot identity (chatHistory, worldInfoBefore, worldInfoAfter, dialogueExamples, personaDescription). RC surfaces these as its named marker slots.",
          "producers": [
            "RC",
            "ST"
          ]
        },
        {
          "name": "placement",
          "optional": false,
          "type": "PromptPlacement",
          "meaning": "",
          "producers": []
        },
        {
          "name": "injectionDepth",
          "optional": false,
          "type": "number",
          "meaning": "message depth for in_chat/append placements (0 = most recent; ST `injection_depth`, def 4).",
          "producers": [
            "ST"
          ]
        },
        {
          "name": "injectionOrder",
          "optional": false,
          "type": "number",
          "meaning": "relative-order weight; lower appears first (ST `injection_order`, default 100).",
          "producers": [
            "ST"
          ]
