        {
          "name": "forbidOverrides",
          "optional": false,
          "type": "boolean",
          "meaning": "ST `forbid_overrides`: a character may not override this prompt.",
          "producers": [
            "ST"
          ]
        },
        {
          "name": "injectionTrigger",
          "optional": true,
          "type": "string[]",
          "meaning": "generation types that trigger this injection (\"normal\", \"continue\", \"impersonate\", ...).",
          "producers": []
