        {
          "name": "isDefault",
          "optional": true,
          "type": "boolean",
          "meaning": "true iff a built-in ST default identifier (not a user-authored prompt).",
          "producers": [
            "ST"
          ]
        },
        {
          "name": "groupId",
          "optional": true,
          "type": "string",
          "meaning": "id of the containing group (PresetGroup.id); absent = top-level / uncategorized.",
          "producers": []
        },
        {
          "name": "wrapInXml",
          "optional": true,
          "type": "boolean",
          "meaning": "Marinara: wrap this block's content in an XML tag on build.",
